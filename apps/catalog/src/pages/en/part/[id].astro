---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PartDetail from "@/components/PartDetail.astro";
import { getPart } from "@/lib/catalog";

const id = Astro.params.id ?? "";
const { payload, part } = await getPart(id);
if (!part) return Astro.redirect("/en/?missing=1");
---

<BaseLayout
  title={`${part.name.en} · ${part.vehicle.year} ${part.vehicle.make} ${part.vehicle.model}`}
  description={`${part.name.en} available. Reference ${part.reference}.`}
  locale="en"
  contact={payload.contact}
>
  <PartDetail part={part} locale="en" contact={payload.contact} />
</BaseLayout>

